{
    "compilerOptions": {
        "declaration": true,
        "incremental": true,
        "lib": ["ES2023"],
        "module": "node16",
        "moduleResolution": "node16",
        "noEmitOnError": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "ES2022",
        "types": ["node", "mocha", "vscode"]
    }
}
